{
  "name": "docs",
  "version": "0.0.11",
  "private": true,
  "scripts": {
    "build": "next build && perl -pi -e 's{\"https://bettercmdtab\\.app/docs/\"}{\"https://bettercmdtab.app/docs\"}g' out/index.html out/*/index.html",
    "dev": "next dev",
    "preview": "bunx --bun serve out -p 3001",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
